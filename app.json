{
  "expo": {
    "name": "Zero Strategy",
    "slug": "zsg",
    "version": "0.2611.1",
    "sdkVersion": "58.0.0",
    "platforms": ["android", "ios"],
    "icon": "./artifacts/zero-strategy/assets/images/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "ru.beska.zsg"
    },
    "ios": {
      "bundleIdentifier": "ru.beska.zsg"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./artifacts/zero-strategy/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./artifacts/zero-strategy/assets/images/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#efe7d7"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
