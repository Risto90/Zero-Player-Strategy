{
  "cli": {
    "version": ">= 16.17.3",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "node": "22.23.3",
      "android": {
        "image": "sdk-58",
        "buildType": "apk"
      },
      "env": {
        "APP_BUILD_TARGET": "native",
        "EXPO_PUBLIC_APP_LOG_MODE": "detailed"
      },
      "pnpm": "9.15.9"
    },
    "production": {
      "autoIncrement": true,
      "node": "22.23.3",
      "android": {
        "image": "sdk-58",
        "buildType": "apk"
      },
      "env": {
        "APP_BUILD_TARGET": "native",
        "EXPO_PUBLIC_APP_LOG_MODE": "errors"
      },
      "pnpm": "9.15.9"
    }
  }
}
