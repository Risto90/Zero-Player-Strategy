{
  "name": "@workspace/zero-strategy",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:human-origins && pnpm run test:human-origin-display && pnpm run test:city-population && pnpm run test:city-regressions && pnpm run test:split-brush && pnpm run test:action-parity && pnpm run test:save-resume && pnpm run test:chronicle && pnpm run test:dead-rulers && pnpm run test:country-profiles && pnpm run test:country-lists-performance && pnpm run test:consulate-partition && pnpm run test:card-draw && pnpm run test:startup && pnpm run test:action-architecture && pnpm run test:auto-strategy && pnpm run test:event-visibility && pnpm run test:city-icons && pnpm run test:person-status && pnpm run test:point-inspection && pnpm run test:nomads && pnpm run test:map-legend && pnpm run test:map-entity-lists && pnpm run test:auto-turn && pnpm run test:flags",
