    "test:human-origin-display": "../api-server/node_modules/.bin/esbuild scripts/human-origin-display.test.mjs --bundle --platform=node --format=esm --alias:expo-file-system=./scripts/expo-file-system.stub.mjs --outfile=/tmp/zero-strategy-human-origin-display.test.mjs && node /tmp/zero-strategy-human-origin-display.test.mjs",
