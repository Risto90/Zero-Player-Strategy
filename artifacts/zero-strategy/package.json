    "test:event-visibility": "../api-server/node_modules/.bin/esbuild scripts/event-visibility.test.mjs --bundle --platform=node --format=esm --alias:expo-file-system=./scripts/expo-file-system.stub.mjs --outfile=/tmp/zero-strategy-event-visibility.test.mjs && node /tmp/zero-strategy-event-visibility.test.mjs",
