    "test:browser-production": "node scripts/browser-production.test.mjs",
    "test:browser-notification-campaign": "EXPO_PUBLIC_NOTIFICATION_E2E=true pnpm run build && node scripts/browser-notification-campaign.test.mjs"
  },
