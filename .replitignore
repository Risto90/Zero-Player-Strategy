# Формат этого файла совпадает с `.dockerignore`.
# Он исключает из образа ненужные для публикации файлы.

# Не нужно копировать кэш pnpm в образ.
.local

# Локальные зависимости и кэши не нужны в production-образе.
node_modules/
.cache/
.pythonlibs/
.ccls-cache/
.git/

# Временные результаты тестирования не используются в production.
artifacts/zero-strategy/generated-artifacts/

# Эти рабочие пакеты нужны только для разработки.
artifacts/mockup-sandbox/
lib/api-client-react/
lib/api-spec/
lib/db/
